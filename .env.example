# --- Twilio ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Numero de WhatsApp habilitado en Twilio (sandbox o productivo), formato whatsapp:+E164
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Poner en false SOLO para pruebas locales sin ngrok (no usar en produccion)
VALIDATE_TWILIO_SIGNATURE=true

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://<tu-recurso>.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- RAG / Vector store (ChromaDB local) ---
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=gandys_knowledge

# --- Scraper ---
SCRAPE_BASE_URL=https://gandys.com.py
SCRAPE_USER_AGENT=GandysBotScraper/1.0 (+contacto@gandys.com.py)
